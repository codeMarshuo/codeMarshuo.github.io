<section class="hero twilight-hero">
  <%- partial('_scene') %>
  <div class="hero-copy">
    <p class="hero-kicker">Marshuo / 个人博客</p>
    <h1>代码与日常。</h1>
    <p class="hero-description">这里是我的学习笔记与项目记录。<br>写代码，也写下解决问题的过程。</p>
    <div class="hero-actions"><a class="primary-link" href="#latest">阅读文章 <span>↓</span></a><a class="secondary-link" href="https://github.com/codeMarshuo" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a></div>
  </div>
  <button class="motion-toggle" id="motion-toggle" aria-pressed="false" aria-label="暂停背景动画"><span class="motion-icon">Ⅱ</span><span class="motion-label">暂停动态</span></button>
</section>
<section class="projects-section" id="projects">
  <div class="section-heading"><div><p class="section-kicker">正在做的事</p><h2>项目</h2></div><a href="https://github.com/codeMarshuo?tab=repositories" target="_blank" rel="noopener noreferrer">全部仓库 <span>↗</span></a></div>
  <div class="repo-list">
    <a class="repo-row" href="https://github.com/codeMarshuo/sky_take_out" target="_blank" rel="noopener noreferrer"><div class="repo-info"><h3>苍穹外卖</h3><p>外卖系统后端，包含菜品、套餐与店铺管理。</p></div><span class="repo-language">Java</span><span class="repo-arrow" aria-hidden="true">↗</span></a>
    <a class="repo-row" href="https://github.com/codeMarshuo/MarshuoStudy" target="_blank" rel="noopener noreferrer"><div class="repo-info"><h3>MarshuoStudy</h3><p>学习笔记与代码练习。</p></div><span class="repo-language">Notes</span><span class="repo-arrow" aria-hidden="true">↗</span></a>
    <a class="repo-row" href="https://github.com/codeMarshuo/codeMarshuo.github.io/tree/source" target="_blank" rel="noopener noreferrer"><div class="repo-info"><h3>博客源码</h3><p>本站的 Hexo 主题与文章。</p></div><span class="repo-language">Hexo</span><span class="repo-arrow" aria-hidden="true">↗</span></a>
  </div>
</section>
<div class="home-grid">
  <section id="latest"><div class="section-heading"><div><p class="section-kicker">最近更新</p><h2>文章</h2></div><span class="count"><%= site.posts.length %> 篇</span></div><%- partial('_list', {posts: page.posts.toArray()}) %><% if(page.total > 1){ %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'← 上一页',next_text:'下一页 →'}) %></nav><% } %></section>
  <aside class="sidebar"><section class="side-topics"><h2>按标签阅读</h2><div class="topic-links"><% site.tags.forEach(function(tag){ %><a href="<%= url_for(tag.path) %>"><span><%= tag.name %></span><small><%= tag.length %></small></a><% }); %></div></section><a class="text-link" href="/about/">关于 Marshuo <span>↗</span></a></aside>
</div>
