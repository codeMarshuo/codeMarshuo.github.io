<section class="page-intro"><p class="eyebrow"><%= page.type === 'tags' || page.type === 'categories' ? 'EXPLORE THE NOTES' : 'A LITTLE ABOUT ME' %></p><h1><%= page.title %><span>。</span></h1></section><section class="page-content"><% if(page.type === 'tags' || page.type === 'categories'){ %><div class="taxonomy"><% (page.type === 'tags' ? site.tags.toArray() : learning_categories()).forEach(function(item){ %><a href="<%= url_for(item.path) %>"><%= item.name %><span><%= item.length %> 篇 ↗</span></a><% }); %></div><% }else{ %><div class="prose"><%- page.content %></div><% } %></section>